{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dynamic-budget-api",
  "keep_vars": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.td.etontw.com", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    "FRONTEND_ORIGIN": "https://td.etontw.com",
    "GOOGLE_CLIENT_ID": "524136229806-qm9e7nicq2m2ik201iebmenfob559n6p.apps.googleusercontent.com"
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "dabc6520fdf84469bb094c7a4b504dc7" }],
  "observability": {"enabled": true}
}
